{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "recipe_id": { "type": "string" },
    "name": { "type": "string" },
    "slot": { "type": "string", "enum": ["Arsenal Ofensivo", "Blindagem Operacional", "Ativo de Performance", "Alvará de Risco", "Provisão Logística"] },
    "branch": { "type": "string", "enum": ["Ferragem", "Alquimia", "Joalheria", "Culinária"] },
    "gender": { "type": "string", "enum": ["m", "f"] },
    "min_workshop_level": { "type": "integer", "minimum": 1 },
    "base_power": { "type": "integer" },
    "energy_restore": { "type": "integer" },
    "charges": { "type": "integer" },
    "market_value_base": { "type": "integer", "minimum": 1 },
    "unlock": {
      "type": "object",
      "properties": {
        "method": { "type": "string" }
      },
      "required": ["method"]
    }
  },
  "required": ["recipe_id", "name", "slot", "branch", "gender", "min_workshop_level", "market_value_base", "unlock"]
}
